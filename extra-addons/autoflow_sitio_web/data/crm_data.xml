<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tag_sitio_web" model="crm.tag">
            <field name="name">Sitio web</field>
        </record>
        <!-- De qué sistema es la solicitud: cada uno tiene su sitio web -->
        <record id="tag_autoflow" model="crm.tag">
            <field name="name">AutoFlow</field>
        </record>
        <record id="tag_studio_bella" model="crm.tag">
            <field name="name">Studio Bella</field>
        </record>
    </data>

    <record id="mail_aviso_solicitud" model="mail.template">
        <field name="name">Sitio web: aviso de solicitud de demo</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Nueva solicitud: {{ object.name }}</field>
        <field name="email_from">{{ object.company_id.email_formatted }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #1F2937;">
    <p>Llegó una nueva solicitud de demostración desde el sitio web: <b t-out="object.name"/>.</p>
    <table cellpadding="6" style="border-collapse: collapse;">
        <tr><td><b>Nombre</b></td><td t-out="object.contact_name"/></tr>
        <tr><td><b>Empresa</b></td><td t-out="object.partner_name"/></tr>
        <tr><td><b>Teléfono</b></td><td t-out="object.phone"/></tr>
        <tr><td><b>Correo</b></td><td t-out="object.email_from"/></tr>
    </table>
    <div t-out="object.description"/>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/mail/view?model=crm.lead&amp;res_id={{ object.id }}"
           style="background: #2B78D6; color: #FFFFFF; padding: 10px 16px; border-radius: 6px; text-decoration: none;">
            Abrir en el CRM
        </a>
    </p>
</div>
        </field>
    </record>
</odoo>
