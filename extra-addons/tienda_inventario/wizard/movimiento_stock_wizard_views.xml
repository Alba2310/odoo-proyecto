<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_movimiento_wizard_form" model="ir.ui.view">
        <field name="name">tienda.movimiento.wizard.form</field>
        <field name="model">tienda.movimiento.wizard</field>
        <field name="arch" type="xml">
            <form string="Movimiento de stock">
                <group>
                    <field name="producto_id" options="{'no_create': True}"/>
                    <field name="modo" widget="radio"/>
                    <field name="stock_actual"/>
                    <field name="cantidad" invisible="modo != 'reponer'" required="modo == 'reponer'"/>
                    <field name="stock_contado" invisible="modo != 'ajustar'"/>
                    <field name="referencia" placeholder="Ej.: Factura proveedor 001-001-0001234"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tienda_reponer_stock" model="ir.actions.act_window">
        <field name="name">Reponer stock</field>
        <field name="res_model">tienda.movimiento.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_modo': 'reponer'}</field>
    </record>
</odoo>
