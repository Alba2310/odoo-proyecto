<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_movimiento_list" model="ir.ui.view">
        <field name="name">tienda.movimiento.list</field>
        <field name="model">tienda.movimiento</field>
        <field name="arch" type="xml">
            <list string="Movimientos de stock" create="0" edit="0" delete="0"
                  decoration-success="cantidad &gt; 0" decoration-danger="cantidad &lt; 0">
                <field name="fecha"/>
                <field name="producto_id"/>
                <field name="tipo"/>
                <field name="referencia"/>
                <field name="cantidad" sum="Total"/>
                <field name="saldo"/>
                <field name="usuario_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tienda_movimiento_form" model="ir.ui.view">
        <field name="name">tienda.movimiento.form</field>
        <field name="model">tienda.movimiento</field>
        <field name="arch" type="xml">
            <form string="Movimiento de stock" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="producto_id"/>
                            <field name="tipo"/>
                            <field name="referencia"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="cantidad"/>
                            <field name="saldo"/>
                            <field name="usuario_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tienda_movimiento_search" model="ir.ui.view">
        <field name="name">tienda.movimiento.search</field>
        <field name="model">tienda.movimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar movimientos">
                <field name="producto_id"/>
                <field name="referencia"/>
                <filter name="entradas" string="Entradas" domain="[('cantidad', '&gt;', 0)]"/>
                <filter name="salidas" string="Salidas" domain="[('cantidad', '&lt;', 0)]"/>
                <separator/>
                <filter name="reposiciones" string="Reposiciones" domain="[('tipo', '=', 'reposicion')]"/>
                <filter name="ajustes" string="Ajustes" domain="[('tipo', '=', 'ajuste')]"/>
                <separator/>
                <filter name="fecha" string="Fecha" date="fecha"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_producto" string="Producto" context="{'group_by': 'producto_id'}"/>
                    <filter name="group_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="group_fecha" string="Día" context="{'group_by': 'fecha:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tienda_movimiento" model="ir.actions.act_window">
        <field name="name">Movimientos de stock</field>
        <field name="res_model">tienda.movimiento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Todavía no hay movimientos</p>
            <p>Cada reposición, ajuste o venta queda registrada acá.</p>
        </field>
    </record>
</odoo>
