<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_caja_list" model="ir.ui.view">
        <field name="name">tienda.caja.list</field>
        <field name="model">tienda.caja</field>
        <field name="arch" type="xml">
            <list string="Cajas" decoration-info="estado == 'abierta'" decoration-danger="diferencia &lt; 0">
                <field name="name"/>
                <field name="sucursal_id"/>
                <field name="usuario_id"/>
                <field name="fecha_apertura"/>
                <field name="fecha_cierre"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cantidad_ventas" sum="Total"/>
                <field name="total_efectivo" optional="show" sum="Total"/>
                <field name="total_tarjeta" optional="show" sum="Total"/>
                <field name="total_transferencia" optional="show" sum="Total"/>
                <field name="total_ventas" sum="Total"/>
                <field name="diferencia" sum="Total"/>
                <field name="estado" widget="badge" decoration-info="estado == 'abierta'"
                       decoration-success="estado == 'cerrada'"/>
            </list>
        </field>
    </record>

    <record id="view_tienda_caja_form" model="ir.ui.view">
        <field name="name">tienda.caja.form</field>
        <field name="model">tienda.caja</field>
        <field name="arch" type="xml">
            <form string="Caja">
                <header>
                    <button name="action_cerrar" string="Cerrar caja" type="object" class="btn-primary"
                            invisible="estado != 'abierta' or not id"/>
                    <button name="%(action_report_cierre_caja)d" string="Imprimir resumen" type="action"
                            icon="fa-print" invisible="not id"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sucursal_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="id"/>
                            <field name="usuario_id"/>
                            <field name="fecha_apertura"/>
                            <field name="fecha_cierre" invisible="not fecha_cierre"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Efectivo en la caja">
                            <field name="monto_inicial" readonly="estado != 'abierta'"/>
                            <field name="efectivo_esperado" class="fw-bold" invisible="not id"/>
                            <field name="efectivo_contado" invisible="estado != 'cerrada'"/>
                            <field name="diferencia" invisible="estado != 'cerrada'"
                                   decoration-danger="diferencia &lt; 0" decoration-success="diferencia &gt; 0"/>
                        </group>
                    </group>
                    <group invisible="not id">
                        <group string="Ventas del turno">
                            <field name="cantidad_ventas"/>
                            <field name="total_efectivo"/>
                            <field name="total_tarjeta"/>
                            <field name="total_transferencia"/>
                            <field name="total_ventas" class="fw-bold"/>
                        </group>
                        <group string="IVA incluido en las ventas">
                            <field name="iva_5"/>
                            <field name="iva_10"/>
                        </group>
                    </group>
                    <notebook invisible="not id">
                        <page string="Ventas" name="ventas">
                            <field name="venta_ids" readonly="1">
                                <list decoration-muted="estado == 'cancelada'">
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="cliente_id"/>
                                    <field name="metodo_pago"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total"/>
                                    <field name="estado" widget="badge" decoration-success="estado == 'confirmada'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="nota" placeholder="Observaciones del turno..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tienda_caja_search" model="ir.ui.view">
        <field name="name">tienda.caja.search</field>
        <field name="model">tienda.caja</field>
        <field name="arch" type="xml">
            <search string="Buscar cajas">
                <field name="name"/>
                <field name="usuario_id"/>
                <filter name="mias" string="Mis cajas" domain="[('usuario_id', '=', uid)]"/>
                <separator/>
                <filter name="abiertas" string="Abiertas" domain="[('estado', '=', 'abierta')]"/>
                <filter name="cerradas" string="Cerradas" domain="[('estado', '=', 'cerrada')]"/>
                <filter name="con_diferencia" string="Con diferencia" domain="[('diferencia', '!=', 0)]"/>
                <separator/>
                <filter name="fecha_apertura" string="Fecha" date="fecha_apertura"/>
                <field name="sucursal_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_sucursal" string="Sucursal" context="{'group_by': 'sucursal_id'}"/>
                    <filter name="group_usuario" string="Cajero" context="{'group_by': 'usuario_id'}"/>
                    <filter name="group_dia" string="Día" context="{'group_by': 'fecha_apertura:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tienda_caja" model="ir.actions.act_window">
        <field name="name">Caja</field>
        <field name="res_model">tienda.caja</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Abra la caja para empezar a vender</p>
            <p>Haga clic en <b>Nuevo</b>, elija la sucursal, cargue el fondo inicial (el efectivo para dar vuelto) y guarde.</p>
        </field>
    </record>

    <!-- Asistente de cierre -->
    <record id="view_tienda_caja_cierre_wizard_form" model="ir.ui.view">
        <field name="name">tienda.caja.cierre.wizard.form</field>
        <field name="model">tienda.caja.cierre.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar caja">
                <p>Cuente todo el efectivo que hay en la caja (incluido el fondo inicial) y escríbalo abajo.</p>
                <group>
                    <field name="caja_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="efectivo_esperado"/>
                    <field name="efectivo_contado"/>
                    <field name="diferencia" decoration-danger="diferencia &lt; 0"
                           decoration-success="diferencia &gt; 0"/>
                    <field name="nota" placeholder="Motivo de la diferencia, observaciones..."/>
                </group>
                <footer>
                    <button name="action_cerrar" string="Cerrar caja e imprimir resumen" type="object"
                            class="btn-primary"
                            confirm="Después de cerrar la caja no se pueden cancelar sus ventas. ¿Continuar?"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
