<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Todos los días a las 6:00 de Paraguay (9:00 UTC) crea las cuotas que vencen en los próximos días.
             Si la computadora estaba apagada a esa hora, corre apenas se levanta Odoo. -->
        <record id="cron_generar_cuotas" model="ir.cron">
            <field name="name">Alquileres: crear las cuotas del mes</field>
            <field name="model_id" ref="model_alquiler_contrato"/>
            <field name="state">code</field>
            <field name="code">model._cron_generar_cuotas()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=9, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
