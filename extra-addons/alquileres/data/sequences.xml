<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- no_gap: la numeración no salta si una transacción se deshace (importa en los recibos). -->
        <record id="sequence_alquiler_contrato" model="ir.sequence">
            <field name="name">Contratos de alquiler</field>
            <field name="code">alquiler.contrato</field>
            <field name="prefix">CTR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_alquiler_pago" model="ir.sequence">
            <field name="name">Recibos de alquiler</field>
            <field name="code">alquiler.pago</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
