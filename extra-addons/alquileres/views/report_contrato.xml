<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_alquiler_contrato" model="ir.actions.report">
        <field name="name">Contrato para firmar</field>
        <field name="model">alquiler.contrato</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">alquileres.report_contrato</field>
        <field name="report_file">alquileres.report_contrato</field>
        <field name="print_report_name">'Contrato %s' % object.name</field>
        <field name="binding_model_id" ref="model_alquiler_contrato"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Las cláusulas salen de AlquilerContrato._clausulas(): es un modelo para revisar con un abogado. -->
    <template id="report_contrato">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="contrato">
                <t t-call="web.external_layout">
                    <t t-set="locador" t-value="contrato._parte_locadora()"/>
                    <div class="page" style="font-size: 14px; line-height: 1.6;">
                        <h3 class="text-center mb-1">CONTRATO DE ALQUILER DE VIVIENDA</h3>
                        <p class="text-center text-muted">N° <t t-out="contrato.name"/></p>
                        <p class="mt-3">
                            Entre <strong t-out="locador.name"/><t t-if="locador.vat">, C.I./RUC N° <t t-out="locador.vat"/></t>,
                            en adelante EL LOCADOR, y <strong t-out="contrato.inquilino_id.name"/><t t-if="contrato.inquilino_id.vat">,
                            C.I. N° <t t-out="contrato.inquilino_id.vat"/></t>, en adelante EL LOCATARIO, se celebra el presente
                            contrato de alquiler, sujeto a las siguientes cláusulas:
                        </p>
                        <t t-foreach="contrato._clausulas()" t-as="clausula">
                            <p>
                                <strong><t t-out="contrato._ordinal(clausula_index + 1)"/> – <t t-out="clausula[0].upper()"/>:</strong>
                                <t t-out="clausula[1]"/>
                            </p>
                        </t>
                        <p class="mt-3">
                            En prueba de conformidad se firman dos ejemplares de un mismo tenor, en
                            <t t-out="contrato.propiedad_id.ciudad"/>, el <t t-out="contrato._fecha_texto(contrato.fecha_inicio)"/>.
                        </p>
                        <table class="table table-borderless" style="margin-top: 80px; page-break-inside: avoid;">
                            <tr>
                                <td class="text-center" t-attf-style="width: {{ '30%' if contrato.garante_id else '45%' }}; border-top: 1px solid #000 !important;">
                                    EL LOCADOR<br/><strong t-out="locador.name"/>
                                </td>
                                <td style="width: 5%;"/>
                                <td class="text-center" t-attf-style="width: {{ '30%' if contrato.garante_id else '45%' }}; border-top: 1px solid #000 !important;">
                                    EL LOCATARIO<br/><strong t-out="contrato.inquilino_id.name"/>
                                </td>
                                <t t-if="contrato.garante_id">
                                    <td style="width: 5%;"/>
                                    <td class="text-center" style="width: 30%; border-top: 1px solid #000 !important;">
                                        GARANTE<br/><strong t-out="contrato.garante_id.name"/>
                                    </td>
                                </t>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
