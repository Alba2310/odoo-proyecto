<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cada hora revisa los días laborales sin entrada (hasta ayer) y los marca como falta
         o reposo. Se puede repetir sin duplicar nada. -->
    <record id="cron_marcar_faltas" model="ir.cron">
        <field name="name">Personal: marcar faltas</field>
        <field name="model_id" ref="model_tienda_asistencia"/>
        <field name="state">code</field>
        <field name="code">model._marcar_faltas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- El mismo control, desde el menú, para no esperar a la tarea programada. -->
    <record id="action_marcar_faltas" model="ir.actions.server">
        <field name="name">Revisar faltas ahora</field>
        <field name="model_id" ref="model_tienda_asistencia"/>
        <field name="state">code</field>
        <field name="code">
model._marcar_faltas()
action = env['ir.actions.actions']._for_xml_id('tienda_personal.action_tienda_panel')
        </field>
    </record>
</odoo>
