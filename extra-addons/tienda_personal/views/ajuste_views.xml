<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_ajuste_list" model="ir.ui.view">
        <field name="name">tienda.ajuste.list</field>
        <field name="model">tienda.ajuste</field>
        <field name="arch" type="xml">
            <list string="Bonos y sanciones" decoration-muted="pagado"
                  decoration-danger="tipo == 'bono' and not corresponde_bono and not pagado">
                <field name="fecha"/>
                <field name="empleado_id"/>
                <field name="sucursal_id" optional="hide"/>
                <field name="tipo" optional="hide"/>
                <field name="motivo"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="monto" sum="Total"/>
                <field name="corresponde_bono" column_invisible="1"/>
                <field name="pagado"/>
            </list>
        </field>
    </record>

    <record id="view_tienda_ajuste_form" model="ir.ui.view">
        <field name="name">tienda.ajuste.form</field>
        <field name="model">tienda.ajuste</field>
        <field name="arch" type="xml">
            <form string="Bono o sanción">
                <sheet>
                    <field name="corresponde_bono" invisible="1"/>
                    <div class="alert alert-danger" role="alert"
                         invisible="tipo != 'bono' or not empleado_id or corresponde_bono or pagado">
                        <strong>A este empleado no le corresponde bono este mes:</strong>
                        tiene <field name="faltas_mes" class="d-inline"/> falta(s) sin aviso.
                        Puede guardarlo igual si así lo decide.
                    </div>
                    <group>
                        <group>
                            <field name="empleado_id" options="{'no_create': True}" readonly="pagado"/>
                            <field name="tipo" widget="radio" options="{'horizontal': true}" readonly="pagado"/>
                            <field name="motivo" readonly="pagado"
                                   placeholder="Ej.: buen desempeño, llegada tarde..."/>
                        </group>
                        <group>
                            <field name="fecha" readonly="pagado"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="monto" readonly="pagado"/>
                            <field name="pagado"/>
                            <field name="pago_id" invisible="not pago_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tienda_ajuste_search" model="ir.ui.view">
        <field name="name">tienda.ajuste.search</field>
        <field name="model">tienda.ajuste</field>
        <field name="arch" type="xml">
            <search string="Buscar bonos y sanciones">
                <field name="empleado_id"/>
                <field name="motivo"/>
                <filter name="sin_pagar" string="Sin pagar" domain="[('pagado', '=', False)]"/>
                <filter name="fecha" string="Fecha" date="fecha"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_empleado" string="Empleado" context="{'group_by': 'empleado_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tienda_bono" model="ir.actions.act_window">
        <field name="name">Bonos</field>
        <field name="res_model">tienda.ajuste</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '=', 'bono')]</field>
        <field name="context">{'default_tipo': 'bono'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay bonos cargados</p>
            <p>Asigne bonos a quien usted elija. En rojo aparecen los bonos de quien faltó sin aviso este mes.</p>
        </field>
    </record>

    <record id="action_tienda_sancion" model="ir.actions.act_window">
        <field name="name">Sanciones</field>
        <field name="res_model">tienda.ajuste</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '=', 'sancion')]</field>
        <field name="context">{'default_tipo': 'sancion'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay sanciones cargadas</p>
            <p>Las faltas sin aviso ya no se pagan solas. Acá puede anotar otras sanciones, con o sin descuento.</p>
        </field>
    </record>
</odoo>
