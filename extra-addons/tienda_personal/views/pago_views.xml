<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_pago_list" model="ir.ui.view">
        <field name="name">tienda.pago.list</field>
        <field name="model">tienda.pago</field>
        <field name="arch" type="xml">
            <list string="Pagos" create="0" decoration-muted="estado == 'anulado'" decoration-warning="estado == 'borrador'">
                <field name="name"/>
                <field name="fecha"/>
                <field name="empleado_id"/>
                <field name="sucursal_id" optional="show"/>
                <field name="desde" optional="show"/>
                <field name="hasta" optional="show"/>
                <field name="horas" widget="float_time" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_bonos" optional="hide" sum="Total"/>
                <field name="total_sanciones" optional="hide" sum="Total"/>
                <field name="total" sum="Total"/>
                <field name="estado" widget="badge" decoration-success="estado == 'pagado'"
                       decoration-warning="estado == 'borrador'"/>
            </list>
        </field>
    </record>

    <record id="view_tienda_pago_form" model="ir.ui.view">
        <field name="name">tienda.pago.form</field>
        <field name="model">tienda.pago</field>
        <field name="arch" type="xml">
            <form string="Pago" create="0">
                <header>
                    <button name="action_confirmar" string="Confirmar pago e imprimir recibo" type="object"
                            class="btn-primary" invisible="estado != 'borrador'"
                            confirm="¿Confirmar que se le pagó este total al empleado?"/>
                    <button name="action_actualizar" string="Agregar lo nuevo pendiente" type="object"
                            invisible="estado != 'borrador'"/>
                    <button name="%(action_report_recibo_pago)d" string="Imprimir recibo" type="action"
                            icon="fa-print" invisible="estado != 'pagado'"/>
                    <button name="action_anular" string="Anular pago" type="object" invisible="estado != 'pagado'"
                            confirm="Los días, bonos y sanciones de este pago vuelven a quedar pendientes. ¿Anular?"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,pagado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="empleado_id" readonly="1"/>
                            <field name="sucursal_id"/>
                            <field name="fecha" readonly="estado != 'borrador'"/>
                            <field name="desde"/>
                            <field name="hasta"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="dias"/>
                            <field name="horas" widget="float_time"/>
                            <field name="monto_horas"/>
                            <field name="total_bonos"/>
                            <field name="total_sanciones"/>
                            <field name="total" class="fw-bold fs-4"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Días trabajados" name="dias">
                            <field name="asistencia_ids" readonly="1">
                                <list>
                                    <field name="fecha"/>
                                    <field name="entrada"/>
                                    <field name="salida"/>
                                    <field name="horas" widget="float_time" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="pago_hora"/>
                                    <field name="monto" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bonos y sanciones" name="ajustes">
                            <field name="ajuste_ids" readonly="1">
                                <list decoration-success="tipo == 'bono'" decoration-danger="tipo == 'sancion'">
                                    <field name="fecha"/>
                                    <field name="tipo"/>
                                    <field name="motivo"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="monto"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="nota"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tienda_pago_search" model="ir.ui.view">
        <field name="name">tienda.pago.search</field>
        <field name="model">tienda.pago</field>
        <field name="arch" type="xml">
            <search string="Buscar pagos">
                <field name="name"/>
                <field name="empleado_id"/>
                <filter name="por_pagar" string="Por pagar" domain="[('estado', '=', 'borrador')]"/>
                <filter name="pagados" string="Pagados" domain="[('estado', '=', 'pagado')]"/>
                <separator/>
                <filter name="fecha" string="Fecha" date="fecha"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_empleado" string="Empleado" context="{'group_by': 'empleado_id'}"/>
                    <filter name="group_sucursal" string="Sucursal" context="{'group_by': 'sucursal_id'}"/>
                    <filter name="group_mes" string="Mes" context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tienda_pago" model="ir.actions.act_window">
        <field name="name">Pagos</field>
        <field name="res_model">tienda.pago</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay pagos</p>
            <p>Para pagarle a alguien, use el botón <b>Pagar</b> en el panel o en la ficha del empleado.</p>
        </field>
    </record>
</odoo>
