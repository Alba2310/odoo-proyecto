<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tienda_reposo_list" model="ir.ui.view">
        <field name="name">tienda.reposo.list</field>
        <field name="model">tienda.reposo</field>
        <field name="arch" type="xml">
            <list string="Reposos">
                <field name="empleado_id"/>
                <field name="sucursal_id" optional="hide"/>
                <field name="desde"/>
                <field name="hasta"/>
                <field name="dias"/>
                <field name="motivo"/>
                <field name="certificado_nombre" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_tienda_reposo_form" model="ir.ui.view">
        <field name="name">tienda.reposo.form</field>
        <field name="model">tienda.reposo</field>
        <field name="arch" type="xml">
            <form string="Reposo">
                <sheet>
                    <group>
                        <group>
                            <field name="empleado_id" options="{'no_create': True}"/>
                            <field name="motivo"/>
                            <field name="certificado_nombre" invisible="1"/>
                            <field name="certificado" filename="certificado_nombre"/>
                        </group>
                        <group>
                            <field name="desde"/>
                            <field name="hasta"/>
                            <field name="dias"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Los días de reposo no se pagan, pero no cuentan como falta ni le quitan el bono.
                    </div>
                    <field name="nota" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tienda_reposo_search" model="ir.ui.view">
        <field name="name">tienda.reposo.search</field>
        <field name="model">tienda.reposo</field>
        <field name="arch" type="xml">
            <search string="Buscar reposos">
                <field name="empleado_id"/>
                <field name="motivo"/>
                <filter name="desde" string="Fecha" date="desde"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_empleado" string="Empleado" context="{'group_by': 'empleado_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tienda_reposo" model="ir.actions.act_window">
        <field name="name">Reposos</field>
        <field name="res_model">tienda.reposo</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay reposos cargados</p>
            <p>Cargue el empleado, las fechas, el motivo y la foto del certificado.</p>
        </field>
    </record>
</odoo>
