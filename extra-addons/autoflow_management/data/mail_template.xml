<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_vehicle_ready" model="mail.template">
            <field name="name">AutoFlow: vehículo listo para entregar</field>
            <field name="model_id" ref="model_autoflow_workshop_order"/>
            <field name="subject">Su vehículo está listo · {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Se envía al cliente cuando la orden de servicio pasa a "Listo para entrega"</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Hola <t t-out="object.partner_id.name or ''">cliente</t>,</p>
    <p>
        Le avisamos que su vehículo <strong t-out="object.vehicle_id.display_name or ''">Toyota Hilux 2024</strong>
        ya está listo para retirar del taller.
    </p>
    <p>
        Orden de servicio: <strong t-out="object.name or ''">OS/2026/0001</strong>
        <t t-if="object.service_type != 'warranty'">
            <br/>Total: <strong t-out="format_amount(object.amount_total, object.currency_id) or ''">1.000.000 ₲</strong>
        </t>
    </p>
    <p>Lo esperamos. Al retirarlo le entregamos el acta de entrega con el detalle del trabajo realizado.</p>
    <p>Saludos,<br/><t t-out="object.company_id.name or ''">Concesionario</t></p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
