    <function model="stock.quant" name="action_apply_inventory">
        <function eval="[[('id', 'in', (ref('quant_engine_oil_diesel'),
                                       ref('quant_gearbox_oil'),
                                       ref('quant_brake_fluid'),
                                       ref('quant_coolant'),
                                       ref('quant_air_filter'),
                                       ref('quant_fuel_filter'),
                                       ref('quant_cabin_filter'),
                                       ref('quant_brake_pads_rear'),
                                       ref('quant_brake_disc'),
                                       ref('quant_brake_drum'),
                                       ref('quant_brake_shoes'),
                                       ref('quant_wheel_bearing_front'),
                                       ref('quant_wheel_bearing_rear'),
                                       ref('quant_shock_front'),
                                       ref('quant_shock_rear'),
                                       ref('quant_tie_rod_end'),
                                       ref('quant_ball_joint'),
                                       ref('quant_stabilizer_link'),
                                       ref('quant_timing_belt'),
                                       ref('quant_accessory_belt'),
                                       ref('quant_spark_plug'),
                                       ref('quant_clutch_kit'),
                                       ref('quant_water_pump'),
                                       ref('quant_battery'),
                                       ref('quant_headlight_bulb'),
                                       ref('quant_wiper_blade')))]]"
                  model="stock.quant" name="search"/>
    </function>
