    <function model="stock.quant" name="action_apply_inventory">
        <function eval="[[('id', 'in', (ref('quant_tinte'),
                                       ref('quant_oxidante'),
                                       ref('quant_decolorante'),
                                       ref('quant_keratina'),
                                       ref('quant_mascarilla_profesional'),
                                       ref('quant_esmalte_semi'),
                                       ref('quant_shampoo'),
                                       ref('quant_acondicionador'),
                                       ref('quant_mascarilla'),
                                       ref('quant_aceite_argan'),
                                       ref('quant_protector_termico'),
                                       ref('quant_cera'),
                                       ref('quant_esmalte')))]]"
                  model="stock.quant" name="search"/>
    </function>

