    <!-- ============ Pedidos a proveedores ============ -->
    <!-- Pedido de la semana pasada, ya recibido y con la factura del proveedor en borrador -->
    <record id="compra_01" model="purchase.order">
        <field name="partner_id" ref="proveedor_belleza_total"/>
        <field name="partner_ref">FAC 001-001-0004521</field>
        <field name="date_order" eval="(DateTime.today() + relativedelta(days=-13, weekday=0) + relativedelta(days=1, hour=14, minute=0, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="order_line" eval="[Command.create({'product_id': ref('producto_shampoo'), 'product_qty': 6, 'price_unit': 48000}),
                                        Command.create({'product_id': ref('producto_acondicionador'), 'product_qty': 6, 'price_unit': 48000}),
                                        Command.create({'product_id': ref('producto_esmalte'), 'product_qty': 12, 'price_unit': 12000})]"/>
    </record>
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('compra_01')]"/>
    </function>
    <function model="stock.picking" name="button_validate" context="{'skip_sms': True}">
        <function model="stock.picking" name="search" eval="[[('purchase_id', '=', ref('compra_01'))]]"/>
    </function>
    <function model="purchase.order" name="action_create_invoice">
        <value eval="[ref('compra_01')]"/>
    </function>

    <!-- Pedido en borrador para reponer los insumos que están por terminarse -->
    <record id="compra_02" model="purchase.order">
        <field name="partner_id" ref="proveedor_capilar"/>
        <field name="order_line" eval="[Command.create({'product_id': ref('insumo_keratina'), 'product_qty': 2, 'price_unit': 380000}),
                                        Command.create({'product_id': ref('insumo_tinte'), 'product_qty': 12, 'price_unit': 28000})]"/>
    </record>

    <!-- Pedido confirmado que todavía no llegó: su recepción espera que se valide -->
    <record id="compra_03" model="purchase.order">
        <field name="partner_id" ref="proveedor_belleza_total"/>
        <field name="order_line" eval="[Command.create({'product_id': ref('producto_protector_termico'), 'product_qty': 8, 'price_unit': 40000}),
                                        Command.create({'product_id': ref('producto_aceite_argan'), 'product_qty': 3, 'price_unit': 52000})]"/>
    </record>
    <function model="purchase.order" name="button_confirm">
        <value eval="[ref('compra_03')]"/>
    </function>

    <!-- Avisos de reposición de los productos que ya están por debajo del mínimo -->
    <function model="product.template" name="_bella_avisar_reposicion"/>
</odoo>
