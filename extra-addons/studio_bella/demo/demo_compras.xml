<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Proveedores ============ -->
    <record id="proveedor_capilar" model="res.partner">
        <field name="name">Distribuidora Capilar S.A.</field>
        <field name="is_company" eval="True"/>
        <field name="phone">021 450 300</field>
        <field name="email">ventas@capilar.example.com</field>
        <field name="city">Asunción</field>
        <field name="country_id" ref="base.py"/>
        <field name="supplier_rank">1</field>
    </record>
    <record id="proveedor_belleza_total" model="res.partner">
        <field name="name">Belleza Total Importaciones S.R.L.</field>
        <field name="is_company" eval="True"/>
        <field name="phone">021 580 912</field>
        <field name="email">pedidos@bellezatotal.example.com</field>
        <field name="city">San Lorenzo</field>
        <field name="country_id" ref="base.py"/>
        <field name="supplier_rank">1</field>
    </record>

    <!-- ============ Proveedor, precio de compra y stock mínimo de cada producto ============
