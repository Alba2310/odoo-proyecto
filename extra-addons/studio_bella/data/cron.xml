<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Todos los días a las 10:00 de Paraguay (13:00 UTC) avisa a los clientes que tienen cita mañana. -->
        <record id="cron_recordatorio_citas" model="ir.cron">
            <field name="name">Studio Bella: recordatorios de citas de mañana</field>
            <field name="model_id" ref="model_bella_cita"/>
            <field name="state">code</field>
            <field name="code">model._cron_enviar_recordatorios()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=13, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Todos los días a las 7:00 de Paraguay revisa el stock mínimo (también cubre los ajustes de inventario). -->
        <record id="cron_aviso_reposicion" model="ir.cron">
            <field name="name">Studio Bella: avisos de stock mínimo</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._bella_avisar_reposicion()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=10, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
