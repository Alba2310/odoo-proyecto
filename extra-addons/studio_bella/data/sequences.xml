<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- no_gap: la numeración no salta si una transacción se deshace. -->
        <record id="sequence_bella_cita" model="ir.sequence">
            <field name="name">Citas</field>
            <field name="code">bella.cita</field>
            <field name="prefix">CITA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_bella_venta" model="ir.sequence">
            <field name="name">Ventas de productos</field>
            <field name="code">bella.venta</field>
            <field name="prefix">VTA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
