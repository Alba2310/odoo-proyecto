<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Todos los días a las 10:00 de Paraguay (13:00 UTC) avisa por correo a los dueños que tienen turno
             mañana. -->
        <record id="cron_recordatorio_turnos" model="ir.cron">
            <field name="name">Patitas: recordatorios de los turnos de mañana</field>
            <field name="model_id" ref="model_vet_atencion"/>
            <field name="state">code</field>
            <field name="code">model._cron_recordatorios()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=13, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Todos los días a las 9:00 de Paraguay avisa por correo que se acerca la próxima dosis. -->
        <record id="cron_aviso_vacunas" model="ir.cron">
            <field name="name">Patitas: avisos de vacunas y desparasitaciones</field>
            <field name="model_id" ref="model_vet_aplicacion"/>
            <field name="state">code</field>
            <field name="code">model._cron_avisos()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=12, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
